{
  "paper": {
    "title": "Multi-Scale Feature Rectification and Uncertainty Calibration for Robust Visual Classification",
    "contributions": [
      "Multi-Scale Feature Rectification (MFR) module with dilated multi-receptive context and dynamic channel-spatial gating.",
      "Uncertainty-Aware Calibration (UAC) loss coupling margin-adaptive label smoothing and probability calibration regularization.",
      "Comprehensive multi-dataset (CIFAR-10, CIFAR-100, SVHN) and multi-metric (Top-1, Top-5, Macro-F1, ECE, Latency) benchmark evaluation."
    ],
    "datasets": ["cifar10", "cifar100", "svhn"],
    "metrics": [
      "Top-1 Accuracy (%)",
      "Top-5 Accuracy (%)",
      "Macro-F1 (%)",
      "Expected Calibration Error (ECE, %)",
      "Latency (ms)",
      "Throughput (img/s)"
    ],
